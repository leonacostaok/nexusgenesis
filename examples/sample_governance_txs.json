  "instructions": {
    "how_to_inject": "使用以下步骤在 DevNet 中注入这些交易:",
    "steps": [
      "1. 启动多个节点（使用 run_ai_nodes.bat 或类似脚本）",
      "2. 创建一个简单的注入脚本，从本文件读取交易并通过 P2P 发送给节点",
      "3. 例如，可以使用类似以下的脚本:",
      "   const fs = require('fs');",
      "   const WebSocket = require('ws');",
      "   ",
      "   // 读取交易文件",
      "   const txs = JSON.parse(fs.readFileSync('./examples/sample_governance_txs.json', 'utf8')).transactions;",
      "   ",
      "   // 连接到本地节点",
      "   const ws = new WebSocket('ws://localhost:9847');",
      "   ",
      "   ws.on('open', () => {",
      "     // 发送交易",
      "     txs.forEach(tx => {",
      "       ws.send(JSON.stringify({ type: 'TRANSACTION', tx }));",
      "       console.log(`Sent ${tx.tx_type} transaction: ${tx.tx_id.slice(0, 16)}...`);",
      "     });",
      "   });"
    ],

    "./smart-account": "./src/smart-account.js",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "ethereum",
    "secp256k1",
    "ethers",
    "agent",
    "ai-agent",
    "post-quantum",
    "self-custody",
    "human-takeover",
    "cross-chain",
    "nexusgenesis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexus-genesis/nexusgenesis.git",
    "directory": "packages/chain-eth"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "nexusgenesis-agent-keys": "^0.5.0",
    "nexusgenesis-agent-sdk": "^0.3.0"
  }

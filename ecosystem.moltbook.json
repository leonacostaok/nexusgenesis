{
  "name": "moltbook-heartbeat",
  "script": "scripts/moltbook-heartbeat.js",
  "cwd": "/opt/nexusgenesis",
  "interpreter": "node",
  "restart_delay": 5000,
  "max_restarts": 10,
  "out_file": "/var/log/nexusgenesis/moltbook-heartbeat.out.log",
  "error_file": "/var/log/nexusgenesis/moltbook-heartbeat.err.log",
  "merge_logs": true,
  "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
  "env": {
    "NODE_ENV": "production",
    "MOLTBOOK_HEARTBEAT_INTERVAL_MS": "1800000"
  }
}

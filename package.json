{
  "name": "nexusgenesis-node",
  "version": "1.0.0-bootstrap.1",
  "description": "NexusGenesis — Agent Coordination Protocol (testnet bootstrap). Multi-leader BFT + PQC signatures + Agent discovery.",
  "main": "src/index.js",
  "type": "module",
  "workspaces": [
    "packages/*",
    "mcp-server",
    "examples"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon",
    "bootstrap": "node scripts/bootstrap-agent-network.js",
    "node": "node src/node/genesisNode.js",
    "node2": "node src/node/node2.js",
    "devnet": "node scripts/start_mainnet.js",
    "wallet": "node src/wallet/cli.js",
    "wallet:export": "node scripts/wallet-export.mjs",
    "wallet:import": "node scripts/wallet-import.mjs",
    "wallet:py": "python genesis_wallet.py",
    "migrate:agents": "node src/scripts/migrateAgentRegistryIdentity.js",
    "test": "node --test test/*.test.js",
    "test:security": "node --test test/security.test.js",
    "test:onboarding": "node tests/test-onboarding-api.js && node tests/test-onboarding-e2e.js",
    "test:wallets": "node tests/test-custody-token.js && node tests/test-wallet-sign-http.js && node tests/test-admin-auth-production.js && node tests/test-agent-wallet-manager.js",
    "test:backup": "node tests/test-master-key-backup.js",
    "test:banner": "node tests/test-onboarding-banner.js",
    "test:wallet-page": "node tests/test-wallet-page-bugfixes.js",
    "cli": "node cli.js"
  },
  "bin": {
    "nexusgenesis": "./cli.js"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.1",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.15.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "commander": "^11.0.0",
    "cors": "^2.8.6",
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.1",
    "openai": "^6.25.0",
    "superdilithium": "^2.0.6",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^9.0.0",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai-agents",
    "autonomous-agents",
    "agent-coordination",
    "agent-protocol",
    "multi-agent-system",
    "mcp",
    "llm",
    "web3-ai",
    "agentic",
    "blockchain",
    "bft-consensus",
    "pqc",
    "dilithium",
    "post-quantum",
    "ainvm",
    "decentralized-ai",
    "p2p",
    "testnet",
    "nexusgenesis"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14"
  }
}

# NexusGenesis Environment Configuration
# Copy this file to .env and customize for your deployment

# ==========================================
# ADMIN ACCESS
# ==========================================
# Required for privileged operations:
#   - Agent wallet transfers (POST /api/v1/wallet/agent/transfer)
#   - Batch transfers
#   - Steward proposal execution
#   - Forum proposal signing
#
# MUST be changed in production! Use a strong random string.
NG_ADMIN_SECRET=change-me-to-a-strong-random-string

# ==========================================
# WALLET SECURITY
# ==========================================
# 32-byte AES master key (base64 encoded) used to encrypt all agent
# private keys at rest. Source of truth in production.
# Losing this key = losing all agent wallets permanently.
# Generate with: node scripts/generate-master-key.mjs
# Required length: 44 base64 chars (32 raw bytes).
# Legacy: WALLET_ENCRYPTION_PASSWORD (AES-256-CBC) is DEPRECATED.
# Current scheme uses NG_WALLET_MASTER_KEY (AES-256-GCM + PBKDF2).
#
# PRODUCTION REQUIREMENT (fail-fast):
#   When NODE_ENV=production or NODE_ENV=mainnet, the server will
#   REFUSE TO START if this env var is missing, malformed, or
#   the wrong length. The plaintext file fallback (.wallet_master_key
#   in data/wallets/) and auto-generation are DISABLED in production
#   to prevent key loss. Set this in your PM2 env block, systemd
#   unit, or orchestrator secrets store before starting the node.
NG_WALLET_MASTER_KEY=change-me-to-32-bytes-base64-encoded

# ==========================================
# NETWORK CONFIGURATION
# ==========================================
# P2P port for peer-to-peer communication
P2P_PORT=9847

# HTTP port for API and dashboard
HTTP_PORT=19891

# Seed nodes for network discovery (comma-separated host:port)
# Seed nodes MUST produce blocks; non-seed nodes should NOT
SEED_NODES=

# ==========================================
# SYBIL DEFENSE (Mainnet)
# ==========================================
# Enable proof-of-work challenge for agent registration
# When true: requires SHA256 PoW with 4+ leading zeros
# When false (default): relaxed rate limits for testing
POW_REQUIRED=false

# ==========================================
# LOGGING
# ==========================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

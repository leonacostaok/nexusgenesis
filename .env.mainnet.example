# NexusGenesis Mainnet Environment Configuration
# ================================================
# Copy this file to .env and modify for your mainnet deployment
# ⚠️ NOT ACTIVE — this is a template for future mainnet use

# Network Identity
CHAIN_ID=nexus-mainnet
NETWORK_ID=ngn-mainnet-1
NODE_ENV=mainnet

# Node Configuration
NODE_ROLE=genesis
NODE_PORT=9847
HTTP_PORT=19890
NODE_NAME=nexus-genesis-01

# P2P Seeds (comma-separated for production)
SEED_NODES=wss://seed1.nexusgenesis.io:9847,wss://seed2.nexusgenesis.io:9847
BOOTSTRAP_NODES=

# TLS Certificates (for WSS)
TLS_ENABLED=true
TLS_CERT_PATH=certs/fullchain.pem
TLS_KEY_PATH=certs/privkey.pem
TLS_CA_PATH=certs/ca.pem

# Wallet
WALLET_PATH=data/wallets/genesis.json
WALLET_PASSWORD=

# Blockchain
BLOCK_TIME=10000
MAX_TX_PER_BLOCK=500
MIN_FEE=1
MAX_BLOCK_GAS=15000000

# Consensus
COMMITTEE_SIZE=21
MIN_VALIDATORS=7
BFT_ENABLED=true

# Economics
TOTAL_SUPPLY=1000000000
INITIAL_SUPPLY=100000000
ANNUAL_INFLATION_RATE=0.02
BLOCK_REWARD=10

# Logging
LOG_LEVEL=info
LOG_DIR=logs/
LOG_FORMAT=json

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_PATH=/health

# Security
RATE_LIMIT_ENABLED=true
MAX_RPS=100
DDOS_PROTECTION_ENABLED=true

# API
API_KEY=
API_RATE_LIMIT=100

# Bridge
BRIDGE_ENABLED=false
BRIDGE_ETH_RPC=
BRIDGE_SOL_RPC=